
{
  "name": "cloud-attendance-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:emulator": "vite --mode emulator",
    "emulators:demo": "firebase emulators:start --project demo-attendance-rules --only auth,firestore",
    "test:rules": "node --test tests/firestore.rules.test.js",
    "emulator:rules": "firebase emulators:exec --project demo-attendance-rules --only firestore \"npm run test:rules\""
  },
  "dependencies": {
    "firebase": "^10.12.2",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "firebase-tools": "^13.35.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
